{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "dist/**",
        "pkg/**"
      ]
    },
    "@lyricova/components#build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "src/gql/**"]
    },
    "@lyricova/blog#build": {
      "dependsOn": ["^build"],
      "env": ["POSTHOG_SOURCEMAPS", "POSTHOG_ENV_ID", "CI"],
      "passThroughEnv": ["POSTHOG_API_KEY", "API_INTERNAL_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@lyricova/jukebox#build": {
      "dependsOn": ["^build"],
      "env": ["POSTHOG_SOURCEMAPS", "POSTHOG_ENV_ID", "CI"],
      "passThroughEnv": ["POSTHOG_API_KEY", "API_INTERNAL_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "typecheck:native": {
      "dependsOn": [],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
