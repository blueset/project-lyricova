# The build context is the repo source only: every generated tree below is
# produced inside the `builder` stage. Shipping the host's copies would both
# balloon the context (multi-GB) and risk overwriting freshly built artifacts.
.git
.github
.devcontainer
.vscode
.turbo
**/.turbo

# Dependencies - reinstalled from the lockfile in the image.
node_modules
**/node_modules

# Build outputs - regenerated by `npm run build` in the `builder` stage.
**/.next
**/dist
**/build
**/pkg
**/target
**/tsconfig.tsbuildinfo

# Secrets: never bake .env into an image layer. docker-compose supplies these
# at runtime via `env_file`.
.env
.env.*
!.env.sample

# Local scratch.
*.log
.db-backups
.rebuild-backup

# Docs and repo metadata. None of these are build inputs (verified: a full
# `npm run build` succeeds with them absent), and excluding them stops a
# docs-only commit from invalidating `COPY . .` and the expensive
# `npm run build` layer beneath it.
docs
README.md
LICENSE.md
banner.svg
lyricova-schema.sql
.gitattributes
.git-blame-ignore-revs
.nvmrc
.prettierrc.json
.prettierignore
knip.json
