{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "outDir": "build",
    "rootDir": "ts",
    "declaration": true,
    "inlineSourceMap": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "pretty": true
  },
  "include": ["ts/**/*.ts"],
  "exclude": ["node_modules/**", "pkg/**", "ts/**/*.spec.ts"],
  "compileOnSave": false
}
